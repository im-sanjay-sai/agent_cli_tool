{
  "name": "Revenue by Day",
  "baseSql": "SELECT DATE(o.created_at) as day, SUM(o.total_amount) as revenue, COUNT(*) as order_count FROM orders o WHERE o.status = 'completed' GROUP BY DATE(o.created_at) ORDER BY day DESC",
  "chartType": "line",
  "params": [
    {
      "name": "start_date",
      "type": "date",
      "source": "dashboardFilter:date_range"
    },
    {
      "name": "region",
      "type": "string",
      "source": "dashboardFilter:region"
    }
  ],
  "formatting": {
    "xAxisLabel": "Date",
    "xAxisFormat": "MMM_dd",
    "yAxisFields": [
      {
        "field": "revenue",
        "label": "Revenue",
        "format": "dollar_amount"
      },
      {
        "field": "order_count",
        "label": "Orders",
        "format": "whole_number"
      }
    ],
    "showLegend": true
  },
  "pivot": null,
  "dateField": {
    "table": "orders",
    "field": "created_at"
  },
  "order": 1
}
