# ── OpenAI (required) ──
OPENAI_API_KEY=sk-proj-your-openai-api-key

# ── Dry Run Mode ──
# Set to "true" to log CLI commands without executing them
# DRY_RUN=true

# ── Quill Server SDK (local proxy at /api/quill) ──
# The private key authenticates with Quill's cloud. Get it from the Quill portal.
QUILL_PRIVATE_KEY=pk_your_private_key_here

# Database type: postgres | mysql | databricks | snowflake | bigquery | redshift
QUILL_DATABASE_TYPE=postgres

# Option A: Connection string (simplest)
QUILL_DATABASE_CONNECTION_STRING=postgresql://user:password@host:5432/dbname

# Option B: Individual fields (use instead of connection string)
# QUILL_DATABASE_HOST=localhost
# QUILL_DATABASE_PORT=5432
# QUILL_DATABASE_NAME=mydb
# QUILL_DATABASE_USER=myuser
# QUILL_DATABASE_PASSWORD=mypassword

# Option C: Databricks-specific
# QUILL_DATABASE_HOST=dbc-xxxxx.cloud.databricks.com
# QUILL_DATABASE_PATH=sql/1.0/warehouses/xxxxx
# QUILL_DATABASE_TOKEN=dapi_xxxxx
