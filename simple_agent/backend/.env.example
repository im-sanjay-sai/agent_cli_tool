# ── OpenAI ──
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.2

# ── Server ──
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ── Quill Server SDK ──
# Same env vars as the old agent/.env.local (copy them directly)
QUILL_PRIVATE_KEY=pk_your-quill-private-key
QUILL_CLIENT_ID=your-quill-client-id
QUILL_DATABASE_TYPE=postgres

# Option A: Connection string (simplest)
QUILL_DATABASE_CONNECTION_STRING=postgres://user:pass@host:5432/dbname

# Option B: Individual fields (uncomment these, remove connection string above)
# QUILL_DATABASE_HOST=localhost
# QUILL_DATABASE_PORT=5432
# QUILL_DATABASE_NAME=mydb
# QUILL_DATABASE_USER=myuser
# QUILL_DATABASE_PASSWORD=mypassword

# ── Session Sandbox / Hybrid Routing ──
# Enable per-chat cloned environments
SESSION_SANDBOX_ENABLED=true
# Session TTL before automatic cleanup (hours)
SESSION_TTL_HOURS=24
# Auto-delete sandbox after promote
SESSION_AUTO_DISCARD_ON_PROMOTE=true
# Hosted metadata server for hybrid direct routes:
# clone-environment, promote-environment, diff-environment
QUILL_METADATA_SERVER_URL=http://localhost:8080
# Optional override for session CLI query endpoint
# QUILL_AGENT_QUERY_ENDPOINT=http://localhost:3001/api/quill
